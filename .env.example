# Copy this file to .env.local and fill in both values.
# Find them in Supabase: your project > Connect (top of the page).
#
# Both values are safe to use in a web app. Never put the "secret" or
# "service_role" key here: anything starting with VITE_ is visible to visitors.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
